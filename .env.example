# Copy to .env.local and fill in. .env.local is gitignored — it never leaves the machine.
#
# When the app runs ON the same laptop as the MySQL container, use 127.0.0.1.
# When it runs on a different machine on the wifi, use that laptop's LAN IP.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=family_health

# Gree air conditioner on the LAN (AES-encrypted JSON over UDP 7000).
# If this is blank or the unit is off, the AC card shows an error and the rest
# of the dashboard is unaffected. Find the address with scripts/find-ac.mjs.
AC_HOST=
