# Copy to .env.local and fill in. .env.local is gitignored — it never leaves the
# machine. Do NOT put real values in this file: it IS tracked by git.

# --- Database -------------------------------------------------------------
# When the app runs ON the same laptop as the MySQL container, use 127.0.0.1.
# When it runs on a different machine on the wifi, use that laptop's LAN IP.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=family_health

# --- Gree air conditioner (local, UDP 7000) -------------------------------
# Find the address with: node scripts/find-ac.mjs
# If this is blank or the unit is off, that card shows an error and the rest of
# the dashboard is unaffected.
AC_HOST=
AC_LABEL=Lounge

# --- Hisense air conditioner (ConnectLife cloud) --------------------------
# Needs scripts/connectlife_service.py running (see README, or use
# docker/connectlife/compose.yml). Leave CONNECTLIFE_URL blank to hide the card.
# The account must use email + password; Google/Apple SSO logins do not work.
CONNECTLIFE_URL=http://127.0.0.1:8787
CONNECTLIFE_LABEL=Master bedroom
CONNECTLIFE_USERNAME=
CONNECTLIFE_PASSWORD=
